diff --git a/modulefiles/build.nimbus.intelllvm.lua b/modulefiles/build.nimbus.intelllvm.lua
new file mode 100644
index 00000000..eb28e979
--- /dev/null
+++ b/modulefiles/build.nimbus.intelllvm.lua
@@ -0,0 +1,44 @@
+help([[
+Load environment to compile UFS_UTILS on Nimbus using Intel oneAPI (ifx)
+]])
+
+-- Module paths and versions come from global-workflow versions/build.nimbus.ver
+prepend_path("MODULEPATH", os.getenv("intel_modulepath") or "/opt/intel/oneapi/modulefiles")
+prepend_path("MODULEPATH", os.getenv("stack_core_path") or "/lfs/work/alexander_richert/stack/spack-stack/envs/nco-sci-oneapi-2026.1.0/modules_flat/Core")
+
+load("tbb")
+load("compiler-rt")
+load("umf")
+load(pathJoin("mpi", os.getenv("stack_intel_mpi_ver") or "2021.18"))
+
+local ufs_utils_modules = {
+  {["cmake"]           = "3.31.11"},
+  {["jasper"]          = "4.2.8"  },
+  {["zlib"]            = "1.3.2"  },
+  {["libpng"]          = "1.6.55" },
+  {["hdf5"]            = "1.14.5" },
+  {["netcdf-c"]        = "4.9.2"  },
+  {["netcdf-fortran"]  = "4.6.1"  },
+  {["bacio"]           = "2.4.1"  },
+  {["g2"]              = "3.5.1"  },
+  {["ip"]              = "5.4.0"  },
+  {["sp"]              = "2.5.0"  },
+  {["nemsio"]          = "2.5.5"  },
+  {["w3emc"]           = "2.13.0" },
+  {["sigio"]           = "2.3.3"  },
+  {["esmf"]            = "8.8.0"  },
+}
+
+for i = 1, #ufs_utils_modules do
+  for name, default_version in pairs(ufs_utils_modules[i]) do
+    local env_version_name = string.gsub(name, "-", "_") .. "_ver"
+    load(pathJoin(name, os.getenv(env_version_name) or default_version))
+  end
+end
+
+setenv("I_MPI_CC", "icx")
+setenv("I_MPI_FC", "ifx")
+setenv("CC", "mpiicx")
+setenv("FC", "mpiifx")
+
+whatis("Description: UFS_UTILS build environment on Nimbus")
