suite gfs_v17_test
  family primary
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h2/emc/global/noscrub/anton.fernando/global-workflow_gfsv17'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'para'
    edit QUEUE 'dev'
    edit EXPDIR '%PACKAGEHOME%/parm/config/gfs'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h2/emc/global/noscrub/anton.fernando/gfs/output'
    edit DATAROOT '/lfs/h2/emc/global/noscrub/anton.fernando/gfs/rundirs'
    edit DBNLOGDIR '/lfs/h2/emc/global/noscrub/anton.fernando/gfs/output/dbnlog'
    edit ECF_INCLUDE '/lfs/h2/emc/global/noscrub/anton.fernando/global-workflow_gfsv17/ecf/include'
    edit SENDDBN 'NO'

    family 00
      edit CYC '00'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'

      family gfs
        edit RUN 'gfs'

        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 0300 and :TIME < 0630
              event 1 release_gfs_atmos_prep
            task jgfs_atmos_prep
              trigger jgfs_atmos_prep_fsm:release_gfs_atmos_prep
          endfamily
        endfamily

        family init
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily
        endfamily

        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
          endfamily
        endfamily

        family forecast
          task jgfs_fcst
            edit RJN 'forecast'
            trigger ../../analysis/atmos/jgfs_atmos_analupp==complete
        endfamily

      endfamily
    endfamily

    family 06
      edit CYC '06'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'

      family gfs
        edit RUN 'gfs'

        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 0900 and :TIME < 1230
              event 1 release_gfs_atmos_prep
            task jgfs_atmos_prep
              trigger jgfs_atmos_prep_fsm:release_gfs_atmos_prep
          endfamily
        endfamily

        family init
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily
        endfamily

        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
          endfamily
        endfamily

        family forecast
          task jgfs_fcst
            edit RJN 'forecast'
            trigger ../../analysis/atmos/jgfs_atmos_analupp==complete
        endfamily

      endfamily
    endfamily

  endfamily
endsuite
