%include <slurm_ursa.h>
%include <head_ursa.h>
%include <envir_ursa.h>

set -x

export HOMEglobal=%HOMEglobal%
source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export job="stage_ic"
export jobid="${job}.${SLURM_JOB_ID:-$$}"

"${HOMEglobal}/dev/jobs/JGLOBAL_STAGE_IC"
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT***"
  ecflow_client --abort
  exit "${status}"
fi

%include <tail_ursa.h>
