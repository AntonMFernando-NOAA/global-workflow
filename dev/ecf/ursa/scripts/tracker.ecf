#!/bin/bash
#SBATCH --job-name=%RUN%_tracker_%CYC%
#SBATCH --account=%ACCOUNT%
#SBATCH --partition=%QUEUE%
#SBATCH --time=00:10:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=6G

%include <head_ursa.h>
%include <envir_ursa.h>

set -x

export HOMEglobal=%HOMEglobal%
source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export job="tracker"
export jobid="${job}.${SLURM_JOB_ID:-$$}"

"${HOMEglobal}/dev/jobs/JGFS_ATMOS_CYCLONE_TRACKER"
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT***"
  ecflow_client --abort
  exit "${status}"
fi

%include <tail_ursa.h>
