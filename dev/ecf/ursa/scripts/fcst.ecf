#!/bin/bash
#SBATCH --job-name=%RUN%_fcst_%CYC%
#SBATCH --account=%ACCOUNT%
#SBATCH --partition=%QUEUE%
#SBATCH --time=03:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --exclusive

%include <head_ursa.h>
%include <envir_ursa.h>

set -x

export HOMEglobal=%HOMEglobal%

# fcst.sh uses ufswm modules on WCOSS2, run modules elsewhere
source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export job="fcst"
export jobid="${job}.${SLURM_JOB_ID:-$$}"
export FCST_SEGMENT=0

"${HOMEglobal}/dev/jobs/JGLOBAL_FORECAST"
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT***"
  ecflow_client --abort
  exit "${status}"
fi

%include <tail_ursa.h>
