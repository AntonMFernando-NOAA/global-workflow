#SBATCH --job-name=%RUN%_atmos_prod_%CYC%
#SBATCH --account=%ACCOUNT%
#SBATCH --partition=%QUEUE%
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=24
#SBATCH --cpus-per-task=1
#SBATCH --exclusive

%include <head_ursa.h>
%include <envir_ursa.h>

set -x

export HOMEglobal=%HOMEglobal%
source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export job="atmos_products"

# In Rocoto this is a metatask that fans over forecast hour groups.
# For ecFlow we run all forecast hours serially within this single task.
export FORECAST_HOUR jobid
fhmax=%FHMAX_GFS%
fhr=0
while [[ ${fhr} -le ${fhmax} ]]; do
  fhr3=$(printf '%03d' "${fhr}")
  export FORECAST_HOUR="${fhr}"
  export FHR_LIST="${fhr}"
  jobid="${job}_f${fhr3}.${SLURM_JOB_ID:-$$}"

  "${HOMEglobal}/dev/jobs/JGLOBAL_ATMOS_PRODUCTS"
  status=$?
  if [[ ${status} -ne 0 ]]; then
    ecflow_client --msg="***JOB ${ECF_NAME} ERROR at f${fhr3}***"
    ecflow_client --abort
    exit "${status}"
  fi

  if [[ ${fhr} -lt 120 ]]; then
    fhr=$((fhr + 1))
  else
    fhr=$((fhr + 3))
  fi
done

%include <tail_ursa.h>
