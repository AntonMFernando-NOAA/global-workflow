# C48_ATM_ursa.def — ecFlow suite mirroring the C48_ATM Rocoto CI test
#
# 7 tasks: stage_ic → fcst → atmos_prod → tracker + genesis → arch_vrfy → cleanup
# All tasks call the same J-Jobs as Rocoto (dev/jobs/J*).
#
# Slurm directives are injected via %include <slurm_ursa.h> using
# per-task edit variables (WALLTIME, NODES, NTASKS, CPUS_PER_TASK).

suite C48_ATM_ursa
  # ecFlow server connection
  edit ECF_LOGHOST '%ECF_HOST%'
  edit ECF_PORT    '%ECF_PORT%'

  # File locations
  edit ECF_HOME    '%ECF_HOME%'
  edit ECF_INCLUDE '%ECF_HOME%/include'
  edit ECF_FILES   '%ECF_HOME%/scripts'
  edit ECF_JOBOUT  '%ECF_HOME%/output/%ECF_NAME%.%ECF_TRYNO%'

  # Slurm job submission commands
  edit ECF_JOB_CMD  'sbatch %ECF_JOB%'
  edit ECF_KILL_CMD 'scancel %ECF_RID%'
  edit ECF_STATUS_CMD 'squeue -j %ECF_RID%'

  # Experiment variables (overridden by bootstrap_ursa.sh)
  edit ENVIR    'test'
  edit NET      'gfs'
  edit RUN      'gfs'
  edit APP      'ATM'
  edit ACCOUNT  'fv3-cpu'
  edit QUEUE    'service'
  edit CYC      '12'
  edit PDY      '20210323'
  edit PSLOT    'C48_ATM_ecflow'
  edit CASE     'C48'
  edit FHMAX_GFS '120'

  # Slurm resource defaults (overridden per-task)
  edit WALLTIME '00:30:00'
  edit NODES    '1'
  edit NTASKS   '1'
  edit CPUS_PER_TASK '1'

  family gfs
    edit RUN 'gfs'

    task stage_ic
      edit TASK 'stage_ic'
      edit WALLTIME '00:15:00'

    task fcst
      edit TASK 'fcst'
      edit QUEUE 'u1-compute'
      edit WALLTIME '03:00:00'
      edit EXCLUSIVE 'YES'
      trigger stage_ic == complete

    task atmos_prod
      edit TASK 'atmos_prod'
      edit QUEUE 'u1-compute'
      edit WALLTIME '02:00:00'
      edit NODES '1'
      edit NTASKS '24'
      edit EXCLUSIVE 'YES'
      trigger fcst == complete

    task tracker
      edit TASK 'tracker'
      edit WALLTIME '00:10:00'
      trigger atmos_prod == complete

    task genesis
      edit TASK 'genesis'
      edit WALLTIME '00:40:00'
      trigger atmos_prod == complete

    task arch_vrfy
      edit TASK 'arch_vrfy'
      edit WALLTIME '00:30:00'
      trigger tracker == complete and genesis == complete and atmos_prod == complete

    task cleanup
      edit TASK 'cleanup'
      edit WALLTIME '00:15:00'
      trigger arch_vrfy == complete

  endfamily
endsuite
