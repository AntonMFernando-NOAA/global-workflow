#SBATCH --job-name=enkfgdas_atmos_ens_recenter_%CYC%_%FHRGRP%
#SBATCH --partition=%QUEUE%
#SBATCH --account=%PROJ%-%PROJENVIR%
#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=4
#SBATCH --exclusive

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
export WGF="%WGF%"
export FHRGRP="%FHRGRP%"
export FHRLST="%FHRLST%"
export FHMIN_ECEN="${FHRLST}"
export FHMAX_ECEN="${FHRLST}"
export FHOUT_ECEN="${FHRLST}"
export COMPONENT=${WGF}
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ENKF_ECEN
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
