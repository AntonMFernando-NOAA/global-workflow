#PBS -S /bin/bash
#PBS -N cycle_end_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:05:00
#PBS -l select=1:ncpus=1:mem=1GB
#PBS -l debug=true

model=gfs
%include <head.h>
%include <envir-p1.h>
set -x

# Custom cycle_end for the C96 2-cycle suite.
# Production's cycle_end advances PDY and requeues the next cycle in the
# round (00->06->12->18->00).  The C96 suite only has 12Z (cold-start) and
# 00Z; there is no production-style cycle rotation.  After 12Z we requeue
# the 00Z cycle's cycle_end so it can run; after 00Z we exit cleanly.

cyc=%CYC%
suite_name=$(ecflow_client --query variable "${ECF_NAME}":SUITE)

case ${cyc} in
  12)
    ecflow_client --requeue=force "/${suite_name}/primary/00/cycle_end"
    ;;
  00)
    echo "Final cycle (00Z) reached; suite complete."
    ;;
  *)
    echo "ERROR: unexpected cycle '${cyc}' for the C96 2-cycle suite."
    echo "       Only 12 and 00 are supported."
    exit 1
    ;;
esac

%include <tail.h>
exit 0
