            edit FHRLST 'f005'
          task jenkfgdas_ens_post003
            edit FHRGRP '003'
            edit FHR '006'
            edit FHRLST 'f006'
          task jenkfgdas_ens_post004
            edit FHRGRP '004'
            edit FHR '007'
            edit FHRLST 'f007'
          task jenkfgdas_ens_post005
            edit FHRGRP '005'
            edit FHR '008'
            edit FHRLST 'f008'
          task jenkfgdas_ens_post006
            edit FHRGRP '006'
            edit FHR '009'
            edit FHRLST 'f009'
        endfamily		//post
      endfamily      		//enkfgdas
      task cycle_end
        trigger ../12/gdas/forecast == active or ../12/gdas/forecast == complete
    endfamily			//00

  endfamily                       //primary
endsuite                          //gfs_c96
