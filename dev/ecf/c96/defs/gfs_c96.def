                  edit FHR '003'
                  edit FHR_LIST '3'
                  trigger ../../product/jgdas_atmos_product_f003==complete
                task jgdas_atmos_gempak_f004
                  edit FHR '004'
                  edit FHR_LIST '4'
                  trigger ../../product/jgdas_atmos_product_f004==complete
                task jgdas_atmos_gempak_f005
                  edit FHR '005'
                  edit FHR_LIST '5'
