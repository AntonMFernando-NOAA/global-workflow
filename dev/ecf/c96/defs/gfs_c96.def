              task jgdas_atmos_product_f002
                edit FHR '002'
                edit FHR_LIST '2'
                trigger ../../../forecast/jgdas_fcst_fsm:release_gdas_atmos_product_f002
              task jgdas_atmos_product_f003
                edit FHR '003'
                edit FHR_LIST '3'
                trigger ../../../forecast/jgdas_fcst_fsm:release_gdas_atmos_product_f003
              task jgdas_atmos_product_f004
                edit FHR '004'
                edit FHR_LIST '4'
                trigger ../../../forecast/jgdas_fcst_fsm:release_gdas_atmos_product_f004
              task jgdas_atmos_product_f005
                edit FHR '005'
                edit FHR_LIST '5'
