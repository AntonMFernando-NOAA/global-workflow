            task jenkfgdas_change_res_ens
              trigger ../../../gdas/forecast/jgdas_fcst==complete and ../../forecast/jenkfgdas_fcst_mem001==complete
            task jenkfgdas_atmos_ens_anal_sfc_regrid
              trigger jenkfgdas_atmos_ens_update==complete
            task jenkfgdas_atmos_ens_anal_sfc_gcycle
              trigger jenkfgdas_snow_anal_ens==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
          endfamily		//create
          family recenter
            task jenkfgdas_marine_ens_recenter
              trigger ../../../gdas/analysis/marine/jgdas_marine_bmat_init==complete
            task jenkfgdas_atmos_diag_ens
              trigger ../create/jenkfgdas_atmos_ens_observer==complete
            task jenkfgdas_atmos_ens_recenter000
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '000'
              edit FHRLST '003'
            task jenkfgdas_atmos_ens_recenter001
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '001'
              edit FHRLST '006'
            task jenkfgdas_atmos_ens_recenter002
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '002'
              edit FHRLST '009'
          endfamily		//recenter
        endfamily		//analysis
        family forecast
          trigger analysis/recenter/jenkfgdas_atmos_ens_recenter000==complete and analysis/recenter/jenkfgdas_atmos_ens_recenter001==complete and analysis/recenter/jenkfgdas_atmos_ens_recenter002==complete and analysis/create/jenkfgdas_atmos_ens_anal_sfc_gcycle==complete and analysis/recenter/jenkfgdas_marine_ens_recenter==complete
          task jenkfgdas_fcst_mem001
            edit ENSMEM '001'
            edit MEMDIR 'mem001'
          task jenkfgdas_fcst_mem002
            edit ENSMEM '002'
            edit MEMDIR 'mem002'
        endfamily		//forecast
        family ensstat
