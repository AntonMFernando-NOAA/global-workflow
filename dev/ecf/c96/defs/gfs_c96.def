              trigger jgdas_atmos_anal==complete
            task jgdas_atmos_anal_wdqms
              trigger jgdas_atmos_analdiag==complete
            task jgdas_atmos_anal_sfc_regrid
              trigger ../../prep/atmos/jgdas_atmos_prep==complete and ../../../enkfgdas/analysis/create/jenkfgdas_atmos_ens_update==complete
            task jgdas_atmos_anal_sfc_gcycle
              trigger jgdas_atmos_anal==complete and ../snow/jgdas_atmos_analsnow==complete
            task jgdas_atmos_anal_calc
              trigger jgdas_atmos_anal_sfc_regrid==complete and jgdas_atmos_anal_sfc_gcycle==complete and ../../../../12/enkfgdas/analysis/create/jenkfgdas_change_res_ens==complete
            task jgdas_atmos_analupp
              trigger jgdas_atmos_anal_calc==complete
          endfamily  		//atmos
          family marine
            edit WGF 'marine'
            task jgdas_marine_bmat_init
              trigger ../../../../12/gdas/forecast/jgdas_fcst==complete and ../../../../12/enkfgdas/forecast==complete
            task jgdas_marine_bmat
              trigger jgdas_marine_bmat_init==complete
            task jgdas_marine_anal_init
              trigger jgdas_marine_bmat==complete and ../../prep/marine/jgdas_marine_prepoceanobs==complete
            task jgdas_marine_analvar
              trigger jgdas_marine_anal_init==complete
            task jgdas_marine_analchkpt
              trigger jgdas_marine_analvar==complete and ../../../enkfgdas/analysis/recenter/jenkfgdas_marine_ens_recenter==complete
            task jgdas_marine_analfinal
              trigger jgdas_marine_analchkpt==complete
          endfamily  		//marine
