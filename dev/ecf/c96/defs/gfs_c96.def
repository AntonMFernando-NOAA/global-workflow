              task jgdas_atmos_product_f009
                edit FHR '009'
                edit FHR_LIST '9'
                trigger ../../../forecast/jgdas_fcst_fsm:release_gdas_atmos_product_f009
            endfamily		//product
            task jgdas_atmos_analprod
              trigger ../../forecast/jgdas_fcst_fsm:release_gdas_atmos_product_f000
            family gempak
              family gempak
                task jgdas_atmos_gempak_f000
                  edit FHR '000'
                  edit FHR_LIST '0'
                  trigger ../../product/jgdas_atmos_product_f000==complete
                task jgdas_atmos_gempak_f001
                  edit FHR '001'
                  edit FHR_LIST '1'
                  trigger ../../product/jgdas_atmos_product_f001==complete
