                  trigger ../../product/jgdas_atmos_product_f009==complete
              endfamily		//gempak
              task jgdas_atmos_gempak_meta_ncdc
                trigger gempak==complete
            endfamily		//gempak
          endfamily  		//atmos
          family wave
            edit WGF 'wave'
            family gridded
              task jgdas_wave_post_gridded_f000
                edit FHR '000'
                edit FHR_LIST '0'
                trigger ../../../forecast/jgdas_fcst_fsm:release_gdas_wave_post_gridded_f000
              task jgdas_wave_post_gridded_f001
                edit FHR '001'
