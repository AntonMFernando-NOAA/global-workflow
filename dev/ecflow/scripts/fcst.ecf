%include <slurm.h>
%include <head.h>
%include <envir.h>

set -x

export HOMEglobal=%HOMEglobal%
export EXPDIR=%EXPDIR%
export COMROOT=%COMROOT%
export DATAROOT=%DATAROOT%
export NET=%NET%
export PDY=%PDY%
export cyc=%CYC%
export machine=URSA

source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

# For ensemble members, ENSMEM/MEMDIR are set by the parent family.
# For the control forecast, they default to empty (JGLOBAL_FCST
# uses ${ENSMEM:--1} to detect control vs member).
ENSMEM_VAL="%ENSMEM:%"
if [[ -n "${ENSMEM_VAL}" ]]; then
  export ENSMEM="${ENSMEM_VAL}"
  export MEMDIR="%MEMDIR:%"
  export jobid="fcst_mem${ENSMEM}.${SLURM_JOB_ID:-$$}"
else
  export jobid="fcst.${SLURM_JOB_ID:-$$}"
fi

export job="fcst"
export FCST_SEGMENT=%FCST_SEGMENT%

"${HOMEglobal}/dev/jobs/JGLOBAL_FCST"
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT***"
  ecflow_client --abort
  exit "${status}"
fi

%include <tail.h>
