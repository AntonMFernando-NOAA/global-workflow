%include <slurm.h>
%include <head.h>
%include <envir.h>

set -x

export HOMEglobal=%HOMEglobal%
export EXPDIR=%EXPDIR%
export COMROOT=%COMROOT%
export DATAROOT=%DATAROOT%
export NET=%NET%
export PDY=%PDY%
export cyc=%CYC%
export machine=URSA

source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export ENSMEM=%ENSMEM%
export MEMDIR=%MEMDIR%
export COMPONENT=ocean

export job="oceanice_products"

# Process grouped forecast hours sequentially within this Slurm job.
export FORECAST_HOUR jobid
IFS=',' read -ra _fhrs <<< "%FHR_LIST%"
for fhr in "${_fhrs[@]}"; do
  fhr3=$(printf '%%03d' "${fhr}")
  export FORECAST_HOUR="${fhr}"
  export FHR_LIST="${fhr}"
  jobid="${job}_ocean_f${fhr3}.${SLURM_JOB_ID:-$$}"

  "${HOMEglobal}/dev/jobs/JGLOBAL_OCEANICE_PRODUCTS"
  status=$?
  if [[ ${status} -ne 0 ]]; then
    ecflow_client --msg="***JOB ${ECF_NAME} ERROR at f${fhr3}***"
    ecflow_client --abort
    exit "${status}"
  fi
done

%include <tail.h>
