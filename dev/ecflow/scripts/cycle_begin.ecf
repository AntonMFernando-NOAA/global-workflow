#!/bin/bash
# shellcheck disable=SC1009,SC1072,SC1073
# Starts a cycle of a cycled suite.  The cycle families of the suite are
# reused by every cycle of the same hour, so this task prepares the next
# cycle family: it hands over the date and the log directory of the next
# cycle and requeues the next family, whose run families wait for its own
# cycle_begin.  Requeueing the next family now also resets the states that
# the tasks of this cycle look at when they wait for the next cycle.
%include <head.h>

set -x

suite=%SUITE%
pdy=%PDY%
cyc=%CYC%
# Name of the family that runs the next cycle hour (empty on the last family)
next_family_name="%NEXT_FAMILY:%"

# The doubled percent signs keep ecFlow from reading the date format as variables
next_cycle=$(date --utc --date="${pdy} ${cyc}:00 UTC + %ASSIM_FREQ% hours" +%%Y%%m%%d%%H)

# The last cycle has no next cycle to prepare
if [[ -n "${next_family_name}" && "${next_cycle}" -le "%EDATE%" ]]; then
  next_family="/${suite}/${next_family_name}"
  ecflow_client --alter add variable PDY "${next_cycle:0:8}" "${next_family}"
  ecflow_client --alter add variable LOGDIR "%LOGROOT%/${next_cycle}" "${next_family}"

  for run in $(ecflow_client --query variable "${next_family}:RUNS"); do
    ecflow_client --requeue=force "${next_family}/${run}"
  done
  ecflow_client --requeue=force "${next_family}/cycle_begin"
fi

%include <tail.h>
